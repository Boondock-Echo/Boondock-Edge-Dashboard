# With react-scripts `proxy` set, dev server uses strict allowedHosts from LAN URL.
# If that resolves to empty/undefined, webpack-dev-server fails:
# "options.allowedHosts[0] should be a non-empty string"
DANGEROUSLY_DISABLE_HOST_CHECK=true
REACT_APP_EDGE_SERVER_ENDPOINT=/api
REACT_APP_VERSION=V2.0.0-beta.01
REACT_APP_BUILD_DATE=Aug 31, 2026
